# Express Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Atlas URL)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/RTIC2026?retryWrites=true&w=majority

# JWT Token Secret (secure string)
JWT_SECRET=your_super_secret_jwt_key_here

# Admin Login Credentials (default credentials)
# Note: ADMIN_PASSWORD can be plain-text or a bcrypt hash (prefixed with $2a$, $2b$, etc.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email SMTP Settings (Nodemailer support)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here

# Evaluator Credentials
EVALUATOR_USERNAME=evaluator
EVALUATOR_PASSWORD="Evaluator@RTIC2026"
EVAL_ADMIN_USERNAME=eval_admin
EVAL_ADMIN_PASSWORD="EvalAdmin@RTIC2026"

