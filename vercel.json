{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/server.js" },
    { "source": "/evaluation/(.*)", "destination": "/client/evaluation/index.html" },
    { "source": "/evaluation", "destination": "/client/evaluation/index.html" },
    { "source": "/evaluator/(.*)", "destination": "/client/evaluation/index.html" },
    { "source": "/evaluator", "destination": "/client/evaluation/index.html" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ]
}
